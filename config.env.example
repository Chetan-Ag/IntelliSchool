# IntelliSchool Environment Configuration
# Copy this file to .env and fill in your values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth (Optional - for local prototype)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Scraping Configuration
MANUAL_CAPTCHA=false
SCRAPER_TIMEOUT=30
SCRAPER_HEADLESS=true

# ML Model Configuration
MODEL_PATH=models/best_model.joblib
SHAP_EXPLAINER_PATH=models/shap_explainer.joblib
PREPROCESSING_PIPELINE_PATH=models/preprocessing_pipeline.joblib

# Training Configuration
TRAINING_N_TRIALS=100
TRAINING_CV_FOLDS=5
TRAINING_RANDOM_SEED=42

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=reports/intellischool.log

# Development Configuration
DEBUG=true
ENVIRONMENT=development
